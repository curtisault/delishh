# Cloudflare Pages cache policy.
#
# The rule of thumb: a URL may be cached immutably ONLY if its content
# can never change under that name. Vite hashes /assets/*, so those
# qualify. Everything else is opt-in, and getting it wrong is expensive
# — an immutable response is uncacheable-to-fix for a year, including
# across edge colos you cannot see from one machine.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed, but content-stable: a given .woff2 filename always holds
# that same cut of that same face. Replacing a face means shipping it
# under a new filename, NOT overwriting one of these.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is the entry point to hashed assets; it must never outlive a
# deploy, or a stale document requests assets that no longer exist.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# The frozen copy of DS-01 (docs/design-standard.md is the prose of
# record). Self-contained — its fonts are inlined, so it pulls nothing
# from /fonts and survives being saved or mailed on its own. Unhashed
# HTML, so it revalidates like the rest of the HTML above.
/design-standard.html
  Cache-Control: public, max-age=0, must-revalidate

# NOTE: if this project ever ships generated artifacts under
# /downloads (a PDF regenerated under the same filename), give them
# their own SHORT rule here. Folding them into the /assets block above
# pins readers to a superseded file for a year.
